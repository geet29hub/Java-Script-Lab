<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Grading System</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7f6;
            margin: 40px auto;
            max-width: 450px;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        h2 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #555;
        }
        input {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
        }
        button {
            width: 100%;
            padding: 12px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            font-weight: bold;
            margin-top: 10px;
        }
        button:hover {
            background-color: #218838;
        }
        .error {
            color: #dc3545;
            font-size: 14px;
            margin-top: 5px;
            display: none;
            font-weight: bold;
        }
        #resultBox {
            margin-top: 25px;
            padding: 20px;
            border-radius: 6px;
            display: none;
        }
        .pass { 
            background-color: #d4edda; 
            color: #155724; 
            border: 1px solid #c3e6cb; 
        }
        .fail { 
            background-color: #f8d7da; 
            color: #721c24; 
            border: 1px solid #f5c6cb; 
        }
        .result-row {
            margin-bottom: 8px;
            font-size: 15px;
            border-bottom: 1px dashed rgba(0,0,0,0.05);
            padding-bottom: 4px;
        }
        .result-row:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        footer {
            margin-top: 40px;
            text-align: center;
            font-size: 13px;
            color: #666;
            border-top: 1px solid #ddd;
            padding-top: 15px;
            line-height: 1.5;
        }
        footer span {
            font-weight: bold;
            color: #333;
        }
    </style>
</head>
<body>

    <h2>Student Grading System</h2>
    
    <form id="gradingForm">
        <div class="form-group">
            <label for="studentName">Student Full Name:</label>
            <input type="text" id="studentName" placeholder="Enter student name">
        </div>

        <div class="form-group">
            <label for="studentClass">Class / Division:</label>
            <input type="text" id="studentClass" placeholder="e.g., Class 10-A">
        </div>

        <div class="form-group">
            <label for="studentMarks">Enter Student Marks (0 - 100):</label>
            <input type="number" id="studentMarks" placeholder="e.g., 85">
        </div>

        <!-- Single unified error message field from the first code -->
        <div id="errorMessage" class="error"></div>

        <button type="submit">Calculate & Generate Report</button>
    </form>

    <!-- Report Box display area -->
    <div id="resultBox"></div>

    <!-- Personalized Footer Layout -->
    <footer>
        Designed & Developed by: <span>Gitika Makheja</span><br>
        PRN: <span>24070521024</span>
    </footer>

    <script>
        document.getElementById('gradingForm').addEventListener('submit', function(event) {
            // 1. Stop form from executing a page refresh
            event.preventDefault();

            // 2. Fetch DOM element layers
            const nameInput = document.getElementById('studentName');
            const classInput = document.getElementById('studentClass');
            const marksInput = document.getElementById('studentMarks');
            const errorDiv = document.getElementById('errorMessage');
            const resultDiv = document.getElementById('resultBox');
            
            // 3. Clear any active styling states
            errorDiv.style.display = 'none';
            resultDiv.style.display = 'none';
            resultDiv.className = '';

            // 4. Retrieve values and trim outer whitespace
            const nameValue = nameInput.value.trim();
            const classValue = classInput.value.trim();
            const rawMarks = marksInput.value.trim();
            const marksValue = parseFloat(rawMarks);

            // ==========================================
            // CONTROL STRUCTURE 1: Form Validation Check
            // ==========================================
            if (nameValue === "") {
                showValidationError("Error: Student Name field cannot be left blank.", nameInput);
                return;
            }
            if (classValue === "") {
                showValidationError("Error: Class field cannot be left blank.", classInput);
                return;
            }
            if (rawMarks === "") {
                showValidationError("Error: Marks field cannot be left blank.", marksInput);
                return;
            }
            if (isNaN(marksValue)) {
                showValidationError("Error: Please enter a valid numeric value for marks.", marksInput);
                return;
            }
            if (marksValue < 0 || marksValue > 100) {
                showValidationError("Error: Marks must be strictly between 0 and 100.", marksInput);
                return;
            }

            // ==========================================
            // CONTROL STRUCTURE 2: Grading Evaluation
            // ==========================================
            let grade = '';
            let status = 'pass';
            let outcomeText = 'PASSED';

            if (marksValue >= 90) {
                grade = 'A+';
            } else if (marksValue >= 80) {
                grade = 'A';
            } else if (marksValue >= 70) {
                grade = 'B';
            } else if (marksValue >= 60) {
                grade = 'C';
            } else if (marksValue >= 50) {
                grade = 'D';
            } else {
                grade = 'F';
                status = 'fail';
                outcomeText = 'FAILED';
            }

            // ==========================================
            // UI Render Display Output
            // ==========================================
            resultDiv.innerHTML = `
                <div class="result-row"><strong>Status:</strong> ${outcomeText}</div>
                <div class="result-row"><strong>Name:</strong> ${nameValue}</div>
                <div class="result-row"><strong>Class:</strong> ${classValue}</div>
                <div class="result-row"><strong>Marks Secured:</strong> ${marksValue}%</div>
                <div class="result-row"><strong>Final Grade:</strong> ${grade}</div>
            `;

            resultDiv.classList.add(status);
            resultDiv.style.display = 'block';

            // Local helper function to present validation errors cleanly
            function showValidationError(message, elementToFocus) {
                errorDiv.textContent = message;
                errorDiv.style.display = 'block';
                elementToFocus.focus();
            }
        });
    </script>

</body>
</html>



